#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
CHECK_SCRIPT="$ROOT_DIR/scripts/check_frontend_build.sh"

needs_frontend_check=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ -z "${local_sha:-}" || "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  if [[ -z "${remote_sha:-}" || "$remote_sha" =~ ^0+$ ]]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if git diff --name-only "$range" -- | grep -q '^frontend/'; then
    needs_frontend_check=1
    break
  fi
done

if [[ "$needs_frontend_check" -eq 0 ]]; then
  echo "[pre-push] No frontend changes in push range. Skipping frontend build."
  exit 0
fi

echo "[pre-push] Frontend changes detected. Verifying production build."
"$CHECK_SCRIPT"
