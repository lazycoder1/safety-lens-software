# SafetyLens Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql://safetylens:safetylens@localhost:5432/safetylens
# How often a Postgres-backed process checks for config changes made elsewhere.
SAFETYLENS_CONFIG_REFRESH_SECONDS=2.0

# Authentication
# Optional 32+ byte override. When empty, one is generated once in SAFETYLENS_STATE_DIR.
JWT_SECRET=
# Non-Compose installs may set JWT_SECRET_FILE to a mounted, pre-provisioned file.
# JWT_SECRET_FILE=/run/secrets/safetylens_jwt

# Backend
SAFETYLENS_ENV=dev   # dev | prod (controls logging format)
SAFETYLENS_LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
SAFETYLENS_PORT=8000
# Docker Compose sets this inside the container. For host installs, choose a writable absolute path.
# SAFETYLENS_STATE_DIR=/var/lib/safetylens
# Set a stable, device-unique Compose project name in production (for example, customer-site-device).
# COMPOSE_PROJECT_NAME=safetylens-site-001
# Bound public MJPEG connection resources. Set 0 to disable streams.
MJPEG_MAX_SUBSCRIBERS_PER_CAMERA=16
MJPEG_MAX_SUBSCRIBERS_TOTAL=64
# Best-effort in-process retries for failed initial external alert channels.
# Confirmed successes are not resent, but provider timeouts remain at-least-once.
# Pending retries do not survive a restart; durable delivery needs an outbox.
ALERT_PERSIST_QUEUE_SIZE=256
ALERT_DELIVERY_QUEUE_SIZE=256
ALERT_DELIVERY_RETRY_QUEUE_SIZE=256
ALERT_DELIVERY_WORKERS=4
ALERT_DELIVERY_ATTEMPTS=3
ALERT_DELIVERY_RETRY_DELAY_SECONDS=1.0

# Split edge/model-server mode.
# Set this on the lightweight client-laptop backend to send frames to a GPU host.
# Leave empty on the model-server process itself.
SAFETYLENS_MODEL_SERVER_URL=
SAFETYLENS_MODEL_SERVER_TOKEN=
SAFETYLENS_MODEL_SERVER_TIMEOUT_SECONDS=30
# Compose keeps the model server internal. Remote deployments may publish 8100 with a secured override.
SAFETYLENS_MODEL_SERVER_PORT=8100
# Optional device-built TensorRT engine. Requires the adjacent .engine.json manifest.
# Leave empty to use the portable PyTorch model.
SAFETYLENS_COCO_TENSORRT_ENGINE=
# Optional fixed-prompt PPE engine. Prompt changes automatically fall back to PyTorch.
SAFETYLENS_PPE_TENSORRT_ENGINE=

# RTSP capture bounds and capped reconnect backoff
SAFETYLENS_RTSP_OPEN_TIMEOUT_MS=5000
SAFETYLENS_RTSP_READ_TIMEOUT_MS=5000
SAFETYLENS_RTSP_RECONNECT_BASE_SECONDS=1
SAFETYLENS_RTSP_RECONNECT_MAX_SECONDS=15

# VLM (Ollama)
OLLAMA_URL=http://localhost:11434/api/generate

# Frontend (Vite build-time variables)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# PostgreSQL (used by docker-compose)
POSTGRES_USER=safetylens
POSTGRES_PASSWORD=safetylens
POSTGRES_DB=safetylens

# Testing
TEST_DATABASE_URL=postgresql://localhost:5432/safetylens_test
