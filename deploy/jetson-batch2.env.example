# Rakshak Lens Orin NX primary microbatch profile.
#
# Enable only after the referenced manifest-validated YOLO26 Small INT8 batch-2
# engines have been installed on the model-server model volume. The 2026-07-12
# Jetson gate completed 3,840/3,840 conditional requests at 16 cameras x 4 FPS.
SAFETYLENS_COCO_BATCH2_TENSORRT_ENGINE=/app/models/coco_primary/experiments/int8-small/yolo26s-640-int8-batch2.engine
SAFETYLENS_PPE_BATCH2_TENSORRT_ENGINE=/app/models/ppe_tensorrt_640/experiments/batch2/yoloe-26s-seg-helmet3-640-batch2.engine
SAFETYLENS_REMOTE_INFERENCE_MAX_INFLIGHT=4
SAFETYLENS_REMOTE_INFERENCE_ADMISSION_WAIT_SECONDS=0.125
SAFETYLENS_REMOTE_PRIMARY_BATCH_WAIT_SECONDS=0.006
SAFETYLENS_REMOTE_SPECIALIST_BATCH_WAIT_SECONDS=0.006
SAFETYLENS_REMOTE_PRIMARY_BATCH_IMGSZ=640
SAFETYLENS_INFERENCE_PHASE_GROUP_SIZE=2
