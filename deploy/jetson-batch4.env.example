# Rakshak Lens Orin NX validated four-frame microbatch capacity profile.
#
# The 2026-07-13 Jetson gate completed two 5,040/5,040 conditional cold runs at
# 21 cameras x 4 FPS with zero drops or failures and a freshness-safe tail. The
# referenced manifest-validated engines must be installed on the model-server
# model volume. Keep jetson-batch2.env.example as the immediate rollback. The
# early flush below removes the batch-4 timeout penalty for exact two-camera
# groups; a singleton or three-camera remainder uses the measured 14 ms
# smoothing window.
SAFETYLENS_COCO_BATCH4_TENSORRT_ENGINE=/app/models/coco_primary/experiments/int8-small/batch4/yolo26s-640-int8-batch4.engine
SAFETYLENS_PPE_BATCH4_TENSORRT_ENGINE=/app/models/ppe_tensorrt_640/experiments/batch4/yoloe-26s-seg-helmet3-640-batch4.engine
SAFETYLENS_SPECIALIST_BATCH_CONCURRENT=true
SAFETYLENS_REMOTE_INFERENCE_MAX_INFLIGHT=4
SAFETYLENS_REMOTE_INFERENCE_ADMISSION_WAIT_SECONDS=0.125
SAFETYLENS_REMOTE_PRIMARY_BATCH_WAIT_SECONDS=0.014
SAFETYLENS_REMOTE_SPECIALIST_BATCH_WAIT_SECONDS=0.014
SAFETYLENS_REMOTE_FRAME_BATCH_SIZE=4
SAFETYLENS_REMOTE_BATCH2_EARLY_FLUSH_SECONDS=0.006
SAFETYLENS_REMOTE_PRIMARY_BATCH_IMGSZ=640
SAFETYLENS_INFERENCE_PHASE_GROUP_SIZE=4
