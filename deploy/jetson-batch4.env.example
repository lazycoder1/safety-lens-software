# Rakshak Lens Orin NX validated four-frame microbatch capacity profile.
#
# The 2026-07-12 Jetson gate completed 4,800/4,800 conditional requests at
# 20 cameras x 4 FPS with zero fallbacks, drops, or failures. The referenced
# manifest-validated engines must be installed on the model-server model volume.
# Keep jetson-batch2.env.example as the immediate rollback and prefer it for
# fewer than four active cameras to avoid the 10 ms batch-4 rendezvous wait.
SAFETYLENS_COCO_BATCH4_TENSORRT_ENGINE=/app/models/coco_primary/experiments/int8-small/batch4/yolo26s-640-int8-batch4.engine
SAFETYLENS_PPE_BATCH4_TENSORRT_ENGINE=/app/models/ppe_tensorrt_640/experiments/batch4/yoloe-26s-seg-helmet3-640-batch4.engine
SAFETYLENS_SPECIALIST_BATCH_CONCURRENT=true
SAFETYLENS_REMOTE_INFERENCE_MAX_INFLIGHT=4
SAFETYLENS_REMOTE_INFERENCE_ADMISSION_WAIT_SECONDS=0.125
SAFETYLENS_REMOTE_PRIMARY_BATCH_WAIT_SECONDS=0.010
SAFETYLENS_REMOTE_SPECIALIST_BATCH_WAIT_SECONDS=0.010
SAFETYLENS_REMOTE_FRAME_BATCH_SIZE=4
SAFETYLENS_REMOTE_PRIMARY_BATCH_IMGSZ=640
SAFETYLENS_INFERENCE_PHASE_GROUP_SIZE=4
